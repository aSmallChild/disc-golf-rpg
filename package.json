{
  "name": "disc-golf-rpg",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "pnpm --filter @dgrpg/game dev",
    "build": "pnpm --filter @dgrpg/game build",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  }
}
